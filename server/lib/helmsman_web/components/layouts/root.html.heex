<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <%!-- Applies theme, sidebar state and platform before the stylesheet (no flash, design D5). --%>
    <script phx-track-static src={~p"/assets/js/theme.js"}>
    </script>
    <.live_title default="Helmsman" suffix={Layouts.title_suffix(assigns)} phx-no-format>{assigns[:page_title]}</.live_title>
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
  </head>
  <body class="bg-shell">
    {@inner_content}
    <div id="hm-overlays"></div>
  </body>
</html>
