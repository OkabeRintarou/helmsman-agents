#!/usr/bin/env python3
"""Offline Codex app-server: report only whether isolated header wiring is correct."""
import json
import os
import sys

if "--version" in sys.argv:
    print("codex-cli 0.162.1")
    sys.exit(0)
if sys.argv[1:3] == ["login", "status"]:
    sys.exit(0)

provider = next((arg for arg in sys.argv if arg.startswith("model_providers.helmsman_account=")), "")
correct = (
    'env_http_headers={"Ocp-Apim-Subscription-Key"="HELMSMAN_PROVIDER_HEADER_1","user"="HELMSMAN_PROVIDER_HEADER_2"}' in provider
    and bool(os.environ.get("HELMSMAN_PROVIDER_API_KEY"))
    and os.environ.get("HELMSMAN_PROVIDER_HEADER_1") == "HEADER_ONE_E2E_SENTINEL"
    and os.environ.get("HELMSMAN_PROVIDER_HEADER_2") == "HEADER_TWO_E2E_SENTINEL"
    and all(value not in " ".join(sys.argv) for value in [
        "HEADER_ONE_E2E_SENTINEL", "HEADER_TWO_E2E_SENTINEL"])
)

def emit(value):
    print(json.dumps(value), flush=True)

for line in sys.stdin:
    request = json.loads(line)
    method = request.get("method")
    if method == "initialize":
        emit({"id": request["id"], "result": {"userAgent": "fake-codex"}})
    elif method in ["thread/start", "thread/resume"]:
        emit({"id": request["id"], "result": {
            "thread": {"id": "header-e2e-thread"}, "modelProvider": "helmsman_account"}})
    elif method == "turn/start":
        emit({"id": request["id"], "result": {"turn": {"id": "header-e2e-turn"}}})
        emit({"method": "item/completed", "params": {"threadId": "header-e2e-thread",
            "turnId": "header-e2e-turn", "item": {"type": "agentMessage",
            "id": "message", "text": "headers_correct=true" if correct else "headers_correct=false"}}})
        emit({"method": "turn/completed", "params": {"threadId": "header-e2e-thread",
            "turn": {"id": "header-e2e-turn", "status": "completed"}}})
        break
