# Environment of deploy/docker-compose.yml: copy to deploy/.env, fill in the
# values and keep the file private (chmod 600 deploy/.env). Compose reads it for
# its own ${...} values and passes all of it to the app container.
# The full reference is docs/DEPLOY.md.

## Compose

# The image to run; pin a version for predictable upgrades.
HELMSMAN_IMAGE=ghcr.io/okaberintarou/helmsman:latest
# Host port published for the app's HTTP port 4000 (put a TLS proxy in front).
HELMSMAN_HTTP_PORT=4000
# PostgreSQL password, also used in the app's DATABASE_URL (hex only, no URL
# escaping needed). Generate: openssl rand -hex 24
POSTGRES_PASSWORD=

## Required

# Signs cookies and sessions. Generate: openssl rand -base64 48
SECRET_KEY_BASE=
# Encrypts stored credentials (GitHub App key, provider API keys): base64 of 32
# random bytes. Generate: openssl rand -base64 32
# Keep a copy outside the server: without it the encrypted data is lost.
HELMSMAN_VAULT_KEY=
# The host name users and daemons reach the instance at.
PHX_HOST=hm.example.com
# How email is sent: smtp, or log (emails, including login links, only go to
# the container log).
HELMSMAN_MAILER_ADAPTER=smtp

## Public URL

# Scheme and port of the public URL (default https and 443). For plain HTTP on
# a private network: PHX_URL_SCHEME=http and PHX_URL_PORT=<the port users use>.
# With https, plain-HTTP requests are redirected and cookies are Secure.
PHX_URL_SCHEME=https
PHX_URL_PORT=443
# Comma-separated IPs or CIDR ranges of reverse proxies whose X-Forwarded-For
# and X-Forwarded-Proto are trusted; empty: both headers are ignored. With
# compose, the proxy reaches the app from the Docker network, e.g. 172.16.0.0/12.
HELMSMAN_TRUSTED_PROXIES=

## Mail (HELMSMAN_MAILER_ADAPTER=smtp)

HELMSMAN_MAILER_SMTP_HOST=smtp.example.com
HELMSMAN_MAILER_SMTP_PORT=587
# Leave both unset (commented out) for a relay without authentication.
# HELMSMAN_MAILER_SMTP_USERNAME=
# HELMSMAN_MAILER_SMTP_PASSWORD=
# always | if_available
HELMSMAN_MAILER_SMTP_TLS=if_available
# Sender of system emails (default: Helmsman <noreply@PHX_HOST>).
HELMSMAN_MAILER_FROM=Helmsman <noreply@hm.example.com>

## GitHub App (optional)

# Easiest: create the App from the browser at /admin/github (instance
# administrators; the GitHub App manifest flow). Alternatively set all five;
# they take precedence over the App created there. The private key may be
# given on one line with \n for the line breaks.
# GITHUB_APP_ID=
# GITHUB_APP_CLIENT_ID=
# GITHUB_APP_CLIENT_SECRET=
# GITHUB_WEBHOOK_SECRET=
# GITHUB_APP_PRIVATE_KEY=

## Optional

# Who may register: invite (default) or open.
HELMSMAN_SIGNUP=invite
# Logs: json (default in the image) or text; level debug, info (default),
# notice, warning or error.
HELMSMAN_LOG_FORMAT=json
HELMSMAN_LOG_LEVEL=info
# Daemon downloads: the image serves the binaries it was built with from
# HELMSMAN_DAEMON_DIST_DIR (default /app/daemon-dist); a binary that is not
# there is redirected to HELMSMAN_DAEMON_DOWNLOAD_URL/helmsman-<target>, e.g.
# https://github.com/okaberintarou/helmsman-agents/releases/download/v0.11.0
HELMSMAN_DAEMON_DOWNLOAD_URL=
# Export and import files (default /var/lib/helmsman, the helmsman-data volume).
# HELMSMAN_DATA_DIR=/var/lib/helmsman
# HELMSMAN_DAEMON_DIST_DIR=/app/daemon-dist
# Database connections per instance (default 15); ECTO_IPV6=true to reach the
# database over IPv6.
POOL_SIZE=15
# ECTO_IPV6=false
# Clustering several instances by DNS (not supported yet; leave unset).
# DNS_CLUSTER_QUERY=
