{"method":"item/completed","params":{"item":{"type":"mcpToolCall","id":"exec-bdc349fb-d0ab-4da2-b453-6efcdab4bf4b","server":"helmsman","tool":"list_mcp_resources","status":"completed","arguments":{"server":"helmsman"},"appContext":null,"mcpAppUi":null,"pluginId":null,"readOnlyHint":null,"result":{"content":[{"type":"text","text":"{\"server\":\"helmsman\",\"resources\":[{\"server\":\"helmsman\",\"uri\":\"helmsman://projects\",\"name\":\"projects\",\"title\":\"Projects\",\"description\":\"The active projects of this workspace (JSON, as list_projects returns).\",\"mimeType\":\"application/json\"},{\"server\":\"helmsman\",\"uri\":\"helmsman://workflow\",\"name\":\"workflow\",\"title\":\"Helmsman agent workflow\",\"description\":\"The collaboration rules: roles, statuses and transitions, what to do at each step, feedback.\",\"mimeType\":\"text/markdown\"}]}"}],"structuredContent":null,"_meta":null},"error":null,"durationMs":17},"threadId":"01a12e92-efb8-7a42-8e7a-ece395353952","turnId":"01a12e92-efe7-7e92-ad4e-ec870d3314ac","completedAtMs":1791782751081},"emittedAtMs":1791782751081}
