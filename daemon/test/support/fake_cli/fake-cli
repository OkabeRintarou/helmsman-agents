#!/bin/sh
if [ "${1:-}" = "--version" ]; then
  printf '1.0.0\n'
  exit 0
fi
scenario=
all_args=$(printf '%s\n' "$@")
while [ "$#" -gt 0 ]; do
  case "$1" in
    --scenario) scenario=$2; shift 2 ;;
    *) shift ;;
  esac
done
[ -n "$scenario" ] || exit 2
while IFS= read -r line <&3 || [ -n "$line" ]; do
  command=${line%% *}
  value=${line#* }
  case "$command" in
    json_line_bytes)
      printf '{"method":"unknown","params":{"text":"'
      head -c "$value" /dev/zero | tr '\000' x
      printf '"}}\n'
      ;;
    out|json) printf '%s\n' "$value" ;;
    err) printf '%s\n' "$value" >&2 ;;
    sleep) sleep "$value" ;;
    spawn_child) sleep 600 & printf '%s\n' "$!" > "$FAKE_CLI_CHILD_PID_FILE" ;;
    ignore_term) trap '' TERM ;;
    echo_stdin) cat ;;
    await_stdin_eof) cat > /dev/null ;;
    dump_env) env ;;
    dump_argv) printf '%s\n' "$all_args" ;;
    dump_pwd) pwd ;;
    dump_server_url) printf '%s\n' "$HELMSMAN_SERVER_URL" ;;
    write) printf '%s\n' "$value" > hello.txt ;;
    git_commit) git -c core.hooksPath=/dev/null -c credential.helper= add -A && git -c core.hooksPath=/dev/null -c credential.helper= commit -m "$value" ;;
    barrier) printf ready > "$value.ready"; while [ ! -f "$value.release" ]; do sleep 0.01; done ;;
    # add-run-steering: wait for a steering line on stdin, then answer it.
    await_steer|reject_steer)
      ref=
      while IFS= read -r input; do
        case "$input" in
          # The text is a JSON string literal: kept escaped, without its quotes.
          "steer "*) rest=${input#steer }; ref=${rest%% *}; text=${rest#* }; text=${text#\"}; text=${text%\"}; break ;;
        esac
      done
      if [ "$command" = await_steer ]; then
        steered="${steered:+$steered | }$text"
        printf 'steer_ok %s\n' "$ref"
      else
        printf 'steer_rejected %s %s\n' "$ref" "$value"
      fi
      ;;
    await_line) while IFS= read -r input; do case "$input" in *"$value"*) break ;; esac; done ;;
    result_steered) printf '{"type":"result","data":{"success":true,"text":"done; steered: %s"}}\n' "$steered" ;;
    exit) exit "$value" ;;
    ''|'#'*) ;;
    *) printf 'unknown instruction: %s\n' "$command" >&2; exit 2 ;;
  esac
done 3< "$scenario"
